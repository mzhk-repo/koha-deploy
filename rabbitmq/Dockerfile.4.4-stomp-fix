# RabbitMQ 4.4.0 with a targeted fix for closing native STOMP connections.
FROM rabbitmq:4.4-management-alpine@sha256:4841f6384ef8313c3594cd3f2e9f40c10805f8a61c45f08a9a5d9ddea8199267

COPY patches/4.4.0/rabbit_mgmt_wm_connection.erl /tmp/rabbit_mgmt_wm_connection.erl
RUN ERL_LIBS=/opt/rabbitmq/plugins ERL_FLAGS='+S 1:1 +SDcpu 1 +SDio 1' \
      erlc -o /opt/rabbitmq/plugins/rabbitmq_management-4.4.0/ebin /tmp/rabbit_mgmt_wm_connection.erl \
    && rm /tmp/rabbit_mgmt_wm_connection.erl
